    "FEISHU_REDIRECT_URI": "https://er2-lab-api.zhujunjie418.workers.dev/auth/callback",
    "FEISHU_APP_ID": "cli_aa10819ad9badbe8",
    "BOOTSTRAP_FIRST_USER": "false",
    "PILOT_AUTO_PROVISION": "false",
    "AI_ENABLED": "false",
    "V2_SHADOW_ENABLED": "true",
    "V2_WRITES_ENABLED": "false",
    "LEGACY_GLOBAL_BASE_FALLBACK": "true",
    "LEARNING_RECORDS_ENABLED": "true",
    "WEEKLY_BACKFILL_ENABLED": "true",
    "WEEKLY_DRAFTS_ENABLED": "true",
    "WEEKLY_REVIEWER_PERSON_ID": "P-001",
    "WEEKLY_START_DATES": "{\"P-002\":\"2026-09-07\",\"P-003\":\"2026-09-07\",\"P-004\":\"2026-09-07\",\"P-006\":\"2026-09-14\",\"P-007\":\"2026-09-14\",\"P-008\":\"2026-09-14\"}",
    "TEMPORARY_WEEKLY_VOLUNTARY_READING_PERSON_IDS": "P-007,P-008",
    "LEARNING_REVIEWER_PERSON_ID": "P-002",
    "LEARNING_PROFESSOR_PERSON_ID": "P-001",
    "FINANCE_ENABLED": "true",
    "FINANCE_REVIEWER_PERSON_ID": "P-004",
    "FINANCE_DELEGATE_PERSON_IDS": "P-002",
