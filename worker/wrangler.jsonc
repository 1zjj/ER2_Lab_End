{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "er2-lab-api",
  "main": "src/runtime.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": [
      "* * * * *",
      "0 2 1,20,27 * *"
    ]
  },
  "vars": {
