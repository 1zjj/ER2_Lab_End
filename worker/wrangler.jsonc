{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "er2-lab-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 3 * * 5", "0 10 * * 5"]
  },
  "vars": {
    "FRONTEND_URL": "https://1zjj.github.io/ER2_Lab_End/",
    "FEISHU_REDIRECT_URI": "https://er2-lab-api.zhujunjie418.workers.dev/auth/callback"
  }
}
